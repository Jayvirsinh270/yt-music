# Linus Music Player — Environment Configuration
# Copy this file to .env and fill in your values
# .env is ignored by git — never commit it

# ─── Server ─────────────────────────────────────────────────────────────────
# Host to bind the Flask server to.
# Use 127.0.0.1 for local-only access, 0.0.0.0 for LAN/network access.
LINUS_HOST=127.0.0.1

# Port to run the Flask server on.
LINUS_PORT=5000

# ─── YouTube / yt-dlp ───────────────────────────────────────────────────────
# Path to a Netscape-format cookies.txt file for authenticated YouTube access.
# Only needed if YouTube blocks unauthenticated requests in your region.
# YOUTUBE_COOKIE_FILE=/path/to/cookies.txt

# Browser to pull cookies from automatically (alternative to cookies.txt).
# Values: chrome, firefox, edge, safari, chromium, brave, opera
# YOUTUBE_COOKIES_BROWSER=chrome

# ─── Stream Cache ───────────────────────────────────────────────────────────
# Maximum size of the stream cache directory in MB before LRU eviction kicks in.
# Default: 500 MB
STREAM_CACHE_MAX_MB=500

# ─── Last.fm Scrobbling ─────────────────────────────────────────────────────
# Create an API account at https://www.last.fm/api/account/create
# LASTFM_API_KEY=your_api_key_here
# LASTFM_API_SECRET=your_api_secret_here
